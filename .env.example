[TEMPLATE]
# Copy to .env and fill in. Never commit real secrets.

# ---------- shared ----------
NURSELINGUA_ENV=local
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ---------- Clerk (auth) ----------
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ---------- Spring Boot ----------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nurselingua?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=nurselingua
SPRING_DATASOURCE_PASSWORD=changeme
NURSELINGUA_DEV_AUTH=true          # false in production
NURSELINGUA_CORS_ORIGINS=http://localhost:5173

# ---------- n8n (async STT/TTS workflows) ----------
N8N_ENABLED=false                  # true in production
N8N_WEBHOOK_URL=https://automation.nurselingua.health/webhook/nurselingua
N8N_WEBHOOK_SECRET=change-me-long-random

# ---------- MySQL (docker-compose) ----------
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=nurselingua
MYSQL_USER=nurselingua
MYSQL_PASSWORD=changeme

# ---------- Cloudflare R2 (audio: recordings + cached TTS output) ----------
R2_ENABLED=false
R2_ACCOUNT_ID=xxx
R2_BUCKET=nurselingua-media
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_PUBLIC_BASE_URL=https://media.nurselingua.health

# ---------- AI / Speech (server-side only, reached via n8n workflows) ----------
STT_API_KEY=xxx
TTS_API_KEY=xxx
MT_API_KEY=xxx
